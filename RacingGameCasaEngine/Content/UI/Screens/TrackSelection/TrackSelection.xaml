<Window xmlns="clr-namespace:MGUI.Core.UI.XAML;assembly=MGUI.Core"
        xmlns:dataBinding="clr-namespace:MGUI.Core.UI.DataBinding;assembly=MGUI.Core"
        Width="1280" Height="720" ScreenHorizontalAlignment="Stretch" ScreenVerticalAlignment="Stretch"
        WindowStyle="None" IsTitleBarVisible="False" IsUserResizable="False"
        Padding="0" BorderThickness="0" Background="rgba(0,0,0,0)">
  <!--
    RacingGame's track selection (ADR-0011). RaceTrackSelectionViewModel lays everything out in screen pixels with
    RacingGame's formulas, every frame, and animates the cards' sizes. Nothing takes MGUI's focus: TrackSelectionScreen
    reads the keyboard, the mouse and the gamepad itself.
  -->
  <OverlayPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <!-- Menu decoration (RaceMenuDecorationViewModel): background, then the bouncing logo placed by the view model. -->
    <Image SourceName="Ui.Menu.Background" Stretch="Fill" Opacity="0.85" IsHitTestVisible="False"
           HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
    <Image SourceName="Ui.Menu.Logo" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=Decoration.LogoMargin}"
           Width="{dataBinding:MGBinding Path=Decoration.LogoWidth}" Height="{dataBinding:MGBinding Path=Decoration.LogoHeight}" />
    <!-- Band: black at 0.683 opacity (the atlas texel's 205/255 drawn at 0.85), full width, over the logo's bottom. -->
    <Border BorderThickness="0" Background="rgba(0,0,0,174)" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Top"
            Margin="{dataBinding:MGBinding Path=BandMargin}" Height="{dataBinding:MGBinding Path=BandHeightPixels}" />
    <!-- "SELECT TRACK" header (headers.png HeaderSelectTrackGfxRect). -->
    <Image SourceName="Ui.TrackSelection.Header" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=Header.Margin}" Width="{dataBinding:MGBinding Path=Header.Width}" Height="{dataBinding:MGBinding Path=Header.Height}" />
    <!-- Track cards: the card (dimmed unless selected), and for the selected one its orange outline and its name below. -->
    <Image SourceName="Ui.Track.Beginner" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=Card0.Rect.Margin}" Width="{dataBinding:MGBinding Path=Card0.Rect.Width}" Height="{dataBinding:MGBinding Path=Card0.Rect.Height}" Opacity="{dataBinding:MGBinding Path=Card0.Opacity}" />
    <Image SourceName="Ui.Track.Highlight" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=Card0.Rect.Margin}" Width="{dataBinding:MGBinding Path=Card0.Rect.Width}" Height="{dataBinding:MGBinding Path=Card0.Rect.Height}" Visibility="{dataBinding:MGBinding Path=Card0.SelectedVisibility}" />
    <Image SourceName="Ui.Track.LabelBeginner" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=Card0.Label.Margin}" Width="{dataBinding:MGBinding Path=Card0.Label.Width}" Height="{dataBinding:MGBinding Path=Card0.Label.Height}" Visibility="{dataBinding:MGBinding Path=Card0.SelectedVisibility}" />
    <Image SourceName="Ui.Track.Advanced" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=Card1.Rect.Margin}" Width="{dataBinding:MGBinding Path=Card1.Rect.Width}" Height="{dataBinding:MGBinding Path=Card1.Rect.Height}" Opacity="{dataBinding:MGBinding Path=Card1.Opacity}" />
    <Image SourceName="Ui.Track.Highlight" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=Card1.Rect.Margin}" Width="{dataBinding:MGBinding Path=Card1.Rect.Width}" Height="{dataBinding:MGBinding Path=Card1.Rect.Height}" Visibility="{dataBinding:MGBinding Path=Card1.SelectedVisibility}" />
    <Image SourceName="Ui.Track.LabelAdvanced" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=Card1.Label.Margin}" Width="{dataBinding:MGBinding Path=Card1.Label.Width}" Height="{dataBinding:MGBinding Path=Card1.Label.Height}" Visibility="{dataBinding:MGBinding Path=Card1.SelectedVisibility}" />
    <Image SourceName="Ui.Track.Expert" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=Card2.Rect.Margin}" Width="{dataBinding:MGBinding Path=Card2.Rect.Width}" Height="{dataBinding:MGBinding Path=Card2.Rect.Height}" Opacity="{dataBinding:MGBinding Path=Card2.Opacity}" />
    <Image SourceName="Ui.Track.Highlight" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=Card2.Rect.Margin}" Width="{dataBinding:MGBinding Path=Card2.Rect.Width}" Height="{dataBinding:MGBinding Path=Card2.Rect.Height}" Visibility="{dataBinding:MGBinding Path=Card2.SelectedVisibility}" />
    <Image SourceName="Ui.Track.LabelExpert" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=Card2.Label.Margin}" Width="{dataBinding:MGBinding Path=Card2.Label.Width}" Height="{dataBinding:MGBinding Path=Card2.Label.Height}" Visibility="{dataBinding:MGBinding Path=Card2.SelectedVisibility}" />
    <!-- A SELECT and B BACK, grown and outlined in orange while the mouse is over them. -->
    <Image SourceName="Ui.Button.Select" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=SelectButton.Margin}" Width="{dataBinding:MGBinding Path=SelectButton.Width}" Height="{dataBinding:MGBinding Path=SelectButton.Height}" />
    <Image SourceName="Ui.Button.Highlight" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=SelectButton.Margin}" Width="{dataBinding:MGBinding Path=SelectButton.Width}" Height="{dataBinding:MGBinding Path=SelectButton.Height}" Visibility="{dataBinding:MGBinding Path=SelectButton.HighlightVisibility}" />
    <Image SourceName="Ui.Button.Back" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=BackButton.Margin}" Width="{dataBinding:MGBinding Path=BackButton.Width}" Height="{dataBinding:MGBinding Path=BackButton.Height}" />
    <Image SourceName="Ui.Button.Highlight" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=BackButton.Margin}" Width="{dataBinding:MGBinding Path=BackButton.Width}" Height="{dataBinding:MGBinding Path=BackButton.Height}" Visibility="{dataBinding:MGBinding Path=BackButton.HighlightVisibility}" />
  </OverlayPanel>
</Window>
