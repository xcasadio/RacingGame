    <TextBlock Name="txtName4" Text="{dataBinding:MGBinding Path=Row4.Name}" FontFamily="GameFont" Foreground="rgb(200,200,200)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Row4.NameText.Margin}" />
    <TextBlock Name="txtTime4" Text="{dataBinding:MGBinding Path=Row4.Time}" FontFamily="GameFont" Foreground="rgb(255,255,0)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Row4.TimeText.Margin}" />
    <TextBlock Name="txtRank5" Text="{dataBinding:MGBinding Path=Row5.Rank}" FontFamily="GameFont" Foreground="rgb(200,200,200)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Row5.RankText.Margin}" />
    <TextBlock Name="txtName5" Text="{dataBinding:MGBinding Path=Row5.Name}" FontFamily="GameFont" Foreground="rgb(200,200,200)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Row5.NameText.Margin}" />
    <TextBlock Name="txtTime5" Text="{dataBinding:MGBinding Path=Row5.Time}" FontFamily="GameFont" Foreground="rgb(255,255,0)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Row5.TimeText.Margin}" />
    <TextBlock Name="txtRank6" Text="{dataBinding:MGBinding Path=Row6.Rank}" FontFamily="GameFont" Foreground="rgb(200,200,200)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Row6.RankText.Margin}" />
    <TextBlock Name="txtName6" Text="{dataBinding:MGBinding Path=Row6.Name}" FontFamily="GameFont" Foreground="rgb(200,200,200)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Row6.NameText.Margin}" />
    <TextBlock Name="txtTime6" Text="{dataBinding:MGBinding Path=Row6.Time}" FontFamily="GameFont" Foreground="rgb(255,255,0)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Row6.TimeText.Margin}" />
    <TextBlock Name="txtRank7" Text="{dataBinding:MGBinding Path=Row7.Rank}" FontFamily="GameFont" Foreground="rgb(200,200,200)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
