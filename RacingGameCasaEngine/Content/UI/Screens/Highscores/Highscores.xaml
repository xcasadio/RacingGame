    <TextBlock Name="txtName8" Text="{dataBinding:MGBinding Path=Row8.Name}" FontFamily="GameFont" Foreground="rgb(200,200,200)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Row8.NameText.Margin}" />
    <TextBlock Name="txtTime8" Text="{dataBinding:MGBinding Path=Row8.Time}" FontFamily="GameFont" Foreground="rgb(255,255,0)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Row8.TimeText.Margin}" />
    <TextBlock Name="txtRank9" Text="{dataBinding:MGBinding Path=Row9.Rank}" FontFamily="GameFont" Foreground="rgb(200,200,200)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Row9.RankText.Margin}" />
    <TextBlock Name="txtName9" Text="{dataBinding:MGBinding Path=Row9.Name}" FontFamily="GameFont" Foreground="rgb(200,200,200)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Row9.NameText.Margin}" />
    <TextBlock Name="txtTime9" Text="{dataBinding:MGBinding Path=Row9.Time}" FontFamily="GameFont" Foreground="rgb(255,255,0)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Row9.TimeText.Margin}" />
  </OverlayPanel>
</Window>
