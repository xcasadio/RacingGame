    <TextBlock Name="txtName7" Text="{dataBinding:MGBinding Path=Row7.Name}" FontFamily="GameFont" Foreground="rgb(200,200,200)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
