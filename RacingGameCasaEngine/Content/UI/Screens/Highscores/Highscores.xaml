<Window xmlns="clr-namespace:MGUI.Core.UI.XAML;assembly=MGUI.Core"
        xmlns:dataBinding="clr-namespace:MGUI.Core.UI.DataBinding;assembly=MGUI.Core"
        Width="1280" Height="720" ScreenHorizontalAlignment="Stretch" ScreenVerticalAlignment="Stretch"
        WindowStyle="None" IsTitleBarVisible="False" IsUserResizable="False"
        Padding="0" BorderThickness="0" Background="rgba(0,0,0,0)">
  <!--
    RacingGame's highscores screen (ADR-0013). RaceHighscoresViewModel lays everything out in screen pixels with
    RacingGame's formulas, every frame. As in RacingGame, the sprites and the line are drawn first, then the texts
    (TextureFont.WriteAll ran last). The texts use RacingGame's GameFont at its native size; HighscoresScreen scales them
    at draw time as TextureFont did, and colours the tabs and lines. Nothing takes MGUI's focus: HighscoresScreen reads
    the keyboard, the mouse and the gamepad itself.
  -->
  <OverlayPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <!-- Menu decoration (RaceMenuDecorationViewModel): background, then the bouncing logo placed by the view model. -->
    <Image SourceName="Ui.Menu.Background" Stretch="Fill" Opacity="0.85" IsHitTestVisible="False"
           HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
    <Image SourceName="Ui.Menu.Logo" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=Decoration.LogoMargin}"
           Width="{dataBinding:MGBinding Path=Decoration.LogoWidth}" Height="{dataBinding:MGBinding Path=Decoration.LogoHeight}" />
    <!-- Band: black at 0.683 opacity (the atlas texel's 205/255 drawn at 0.85), full width. -->
    <Border BorderThickness="0" Background="rgba(0,0,0,174)" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Top"
            Margin="{dataBinding:MGBinding Path=BandMargin}" Height="{dataBinding:MGBinding Path=BandHeightPixels}" />
    <!-- "HIGHSCORES" header (headers.png HeaderHighscoresGfxRect). -->
    <Image SourceName="Ui.Highscores.Header" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=Header.Margin}" Width="{dataBinding:MGBinding Path=Header.Width}" Height="{dataBinding:MGBinding Path=Header.Height}" />
    <!-- The two one-pixel lines under the tabs, in RacingGame's colour (192,192,192,128) passed as it is. -->
    <Border BorderThickness="0" Background="rgba(192,192,192,128)" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="{dataBinding:MGBinding Path=Separator.Margin}" Width="{dataBinding:MGBinding Path=Separator.Width}" Height="{dataBinding:MGBinding Path=Separator.Height}" />
    <!-- B BACK, grown and outlined in orange while the mouse is over it. -->
    <Image SourceName="Ui.Button.Back" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=BackButton.Margin}" Width="{dataBinding:MGBinding Path=BackButton.Width}" Height="{dataBinding:MGBinding Path=BackButton.Height}" />
    <Image SourceName="Ui.Button.Highlight" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=BackButton.Margin}" Width="{dataBinding:MGBinding Path=BackButton.Width}" Height="{dataBinding:MGBinding Path=BackButton.Height}" Visibility="{dataBinding:MGBinding Path=BackButton.HighlightVisibility}" />
    <!-- Level tabs, coloured by the screen: yellow when selected, white under the mouse, light grey otherwise. -->
    <TextBlock Name="txtTab0" Text="Beginner" FontFamily="GameFont" Foreground="rgb(211,211,211)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Tab0.Margin}" />
    <TextBlock Name="txtTab1" Text="Advanced" FontFamily="GameFont" Foreground="rgb(211,211,211)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Tab1.Margin}" />
    <TextBlock Name="txtTab2" Text="Expert" FontFamily="GameFont" Foreground="rgb(211,211,211)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Tab2.Margin}" />
    <!-- Board lines: rank and name coloured by the screen (white under the mouse), the time always yellow. -->
    <TextBlock Name="txtRank0" Text="{dataBinding:MGBinding Path=Row0.Rank}" FontFamily="GameFont" Foreground="rgb(200,200,200)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Row0.RankText.Margin}" />
    <TextBlock Name="txtName0" Text="{dataBinding:MGBinding Path=Row0.Name}" FontFamily="GameFont" Foreground="rgb(200,200,200)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Row0.NameText.Margin}" />
    <TextBlock Name="txtTime0" Text="{dataBinding:MGBinding Path=Row0.Time}" FontFamily="GameFont" Foreground="rgb(255,255,0)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Row0.TimeText.Margin}" />
    <TextBlock Name="txtRank1" Text="{dataBinding:MGBinding Path=Row1.Rank}" FontFamily="GameFont" Foreground="rgb(200,200,200)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Row1.RankText.Margin}" />
    <TextBlock Name="txtName1" Text="{dataBinding:MGBinding Path=Row1.Name}" FontFamily="GameFont" Foreground="rgb(200,200,200)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Row1.NameText.Margin}" />
    <TextBlock Name="txtTime1" Text="{dataBinding:MGBinding Path=Row1.Time}" FontFamily="GameFont" Foreground="rgb(255,255,0)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Row1.TimeText.Margin}" />
    <TextBlock Name="txtRank2" Text="{dataBinding:MGBinding Path=Row2.Rank}" FontFamily="GameFont" Foreground="rgb(200,200,200)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Row2.RankText.Margin}" />
    <TextBlock Name="txtName2" Text="{dataBinding:MGBinding Path=Row2.Name}" FontFamily="GameFont" Foreground="rgb(200,200,200)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Row2.NameText.Margin}" />
    <TextBlock Name="txtTime2" Text="{dataBinding:MGBinding Path=Row2.Time}" FontFamily="GameFont" Foreground="rgb(255,255,0)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Row2.TimeText.Margin}" />
    <TextBlock Name="txtRank3" Text="{dataBinding:MGBinding Path=Row3.Rank}" FontFamily="GameFont" Foreground="rgb(200,200,200)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Row3.RankText.Margin}" />
    <TextBlock Name="txtName3" Text="{dataBinding:MGBinding Path=Row3.Name}" FontFamily="GameFont" Foreground="rgb(200,200,200)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Row3.NameText.Margin}" />
    <TextBlock Name="txtTime3" Text="{dataBinding:MGBinding Path=Row3.Time}" FontFamily="GameFont" Foreground="rgb(255,255,0)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Row3.TimeText.Margin}" />
    <TextBlock Name="txtRank4" Text="{dataBinding:MGBinding Path=Row4.Rank}" FontFamily="GameFont" Foreground="rgb(200,200,200)" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
