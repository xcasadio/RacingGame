<Window xmlns="clr-namespace:MGUI.Core.UI.XAML;assembly=MGUI.Core"
        xmlns:dataBinding="clr-namespace:MGUI.Core.UI.DataBinding;assembly=MGUI.Core"
        Width="1280" Height="720" ScreenHorizontalAlignment="Stretch" ScreenVerticalAlignment="Stretch"
        WindowStyle="None" IsTitleBarVisible="False" IsUserResizable="False"
        Padding="0" BorderThickness="0" Background="rgba(0,0,0,0)">
  <OverlayPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <!-- Menu decoration (RaceMenuDecorationViewModel): background, then the bouncing logo placed by the view model. -->
    <Image SourceName="Ui.Menu.Background" Stretch="Fill" Opacity="0.85" IsHitTestVisible="False"
           HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
    <Image SourceName="Ui.Menu.Logo" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=Decoration.LogoMargin}"
           Width="{dataBinding:MGBinding Path=Decoration.LogoWidth}" Height="{dataBinding:MGBinding Path=Decoration.LogoHeight}" />
    <!-- Band and scroll sizes follow the safe area and the UI scale (RaceOptionsViewModel.UpdateLayout). -->
    <Border BorderThickness="0" BorderBrush="rgba(0,0,0,0)" Background="rgba(0,0,0,132)" Padding="32,20,32,20"
            Margin="{dataBinding:MGBinding Path=BandMargin}" Height="{dataBinding:MGBinding Path=BandHeight}"
            HorizontalAlignment="Stretch" VerticalAlignment="Top">
      <StackPanel Orientation="Vertical" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Options" Foreground="rgb(255,156,0)" FontSize="26" UseResponsiveTextScale="True"
                   HorizontalAlignment="Center" TextAlignment="Center" />
        <ScrollViewer Width="{dataBinding:MGBinding Path=ScrollWidth}" Height="{dataBinding:MGBinding Path=ScrollHeight}"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
          <!-- Form fields are bound two ways; the screen writes every change to the front-end state. -->
          <StackPanel Orientation="Vertical" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="Player Name" Foreground="rgb(255,156,0)" FontSize="14" WrapText="True" UseResponsiveTextScale="True" Width="220" />
              <TextBox Name="txtPlayerName" Width="280" CharacterLimit="24" ShowCharacterCount="False"
                       Text="{dataBinding:MGBinding Path=PlayerName, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="Resolution" Foreground="rgb(255,156,0)" FontSize="14" WrapText="True" UseResponsiveTextScale="True" Width="220" />
              <!-- The screen restyles these buttons every frame (current value, hover and focus). -->
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Name="btnResolution0" BorderBrush="rgba(255,255,255,70)" BorderThickness="2" CornerRadius="10" Padding="14,8,14,8"
                        Background="rgba(0,0,0,24)" HorizontalAlignment="Center" HorizontalContentAlignment="Center">
                  <TextBlock Text="1280x720" Foreground="White" FontSize="15" UseResponsiveTextScale="True" HorizontalAlignment="Center" TextAlignment="Center" />
                </Button>
                <Button Name="btnResolution1" BorderBrush="rgba(255,255,255,70)" BorderThickness="2" CornerRadius="10" Padding="14,8,14,8"
                        Background="rgba(0,0,0,24)" HorizontalAlignment="Center" HorizontalContentAlignment="Center">
                  <TextBlock Text="1920x1080" Foreground="White" FontSize="15" UseResponsiveTextScale="True" HorizontalAlignment="Center" TextAlignment="Center" />
                </Button>
                <Button Name="btnResolution2" BorderBrush="rgba(255,255,255,70)" BorderThickness="2" CornerRadius="10" Padding="14,8,14,8"
                        Background="rgba(0,0,0,24)" HorizontalAlignment="Center" HorizontalContentAlignment="Center">
                  <TextBlock Text="2560x1440" Foreground="White" FontSize="15" UseResponsiveTextScale="True" HorizontalAlignment="Center" TextAlignment="Center" />
                </Button>
                <Button Name="btnResolution3" BorderBrush="rgba(255,255,255,70)" BorderThickness="2" CornerRadius="10" Padding="14,8,14,8"
                        Background="rgba(0,0,0,24)" HorizontalAlignment="Center" HorizontalContentAlignment="Center">
                  <TextBlock Text="3840x2160" Foreground="White" FontSize="15" UseResponsiveTextScale="True" HorizontalAlignment="Center" TextAlignment="Center" />
                </Button>
                <Button Name="btnResolution4" BorderBrush="rgba(255,255,255,70)" BorderThickness="2" CornerRadius="10" Padding="14,8,14,8"
                        Background="rgba(0,0,0,24)" HorizontalAlignment="Center" HorizontalContentAlignment="Center">
                  <TextBlock Text="Auto" Foreground="White" FontSize="15" UseResponsiveTextScale="True" HorizontalAlignment="Center" TextAlignment="Center" />
                </Button>
              </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="Driving Mode" Foreground="rgb(255,156,0)" FontSize="14" WrapText="True" UseResponsiveTextScale="True" Width="220" />
              <!-- The screen restyles these buttons every frame (current value, hover and focus). -->
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Name="btnDrivingMode0" BorderBrush="rgba(255,255,255,70)" BorderThickness="2" CornerRadius="10" Padding="14,8,14,8"
                        Background="rgba(0,0,0,24)" HorizontalAlignment="Center" HorizontalContentAlignment="Center">
                  <TextBlock Text="Arcade" Foreground="White" FontSize="15" UseResponsiveTextScale="True" HorizontalAlignment="Center" TextAlignment="Center" />
                </Button>
                <Button Name="btnDrivingMode1" BorderBrush="rgba(255,255,255,70)" BorderThickness="2" CornerRadius="10" Padding="14,8,14,8"
                        Background="rgba(0,0,0,24)" HorizontalAlignment="Center" HorizontalContentAlignment="Center">
                  <TextBlock Text="Simulation" Foreground="White" FontSize="15" UseResponsiveTextScale="True" HorizontalAlignment="Center" TextAlignment="Center" />
                </Button>
              </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="Fullscreen" Foreground="rgb(255,156,0)" FontSize="14" WrapText="True" UseResponsiveTextScale="True" Width="220" />
              <CheckBox IsChecked="{dataBinding:MGBinding Path=IsFullscreen, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="Vertical Sync" Foreground="rgb(255,156,0)" FontSize="14" WrapText="True" UseResponsiveTextScale="True" Width="220" />
              <CheckBox IsChecked="{dataBinding:MGBinding Path=EnableVSync, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="Post Screen Effects" Foreground="rgb(255,156,0)" FontSize="14" WrapText="True" UseResponsiveTextScale="True" Width="220" />
              <CheckBox IsChecked="{dataBinding:MGBinding Path=EnablePostEffects, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="Shadows" Foreground="rgb(255,156,0)" FontSize="14" WrapText="True" UseResponsiveTextScale="True" Width="220" />
              <CheckBox IsChecked="{dataBinding:MGBinding Path=EnableShadows, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="Show FPS" Foreground="rgb(255,156,0)" FontSize="14" WrapText="True" UseResponsiveTextScale="True" Width="220" />
              <CheckBox IsChecked="{dataBinding:MGBinding Path=ShowFps, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="Gamepad Vibration" Foreground="rgb(255,156,0)" FontSize="14" WrapText="True" UseResponsiveTextScale="True" Width="220" />
              <CheckBox IsChecked="{dataBinding:MGBinding Path=EnableVibration, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="Sound Volume" Foreground="rgb(255,156,0)" FontSize="14" WrapText="True" UseResponsiveTextScale="True" Width="220" />
              <Slider Minimum="0" Maximum="100" Value="{dataBinding:MGBinding Path=SoundVolume, Mode=TwoWay}" Width="240" />
              <TextBlock Text="{dataBinding:MGBinding Path=SoundVolumeText}" Foreground="White" FontSize="14" WrapText="True" UseResponsiveTextScale="True" Width="56" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="Music Volume" Foreground="rgb(255,156,0)" FontSize="14" WrapText="True" UseResponsiveTextScale="True" Width="220" />
              <Slider Minimum="0" Maximum="100" Value="{dataBinding:MGBinding Path=MusicVolume, Mode=TwoWay}" Width="240" />
              <TextBlock Text="{dataBinding:MGBinding Path=MusicVolumeText}" Foreground="White" FontSize="14" WrapText="True" UseResponsiveTextScale="True" Width="56" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="Controller Sensitivity" Foreground="rgb(255,156,0)" FontSize="14" WrapText="True" UseResponsiveTextScale="True" Width="220" />
              <Slider Minimum="0" Maximum="100" Value="{dataBinding:MGBinding Path=ControllerSensitivity, Mode=TwoWay}" Width="240" />
              <TextBlock Text="{dataBinding:MGBinding Path=ControllerSensitivityText}" Foreground="White" FontSize="14" WrapText="True" UseResponsiveTextScale="True" Width="56" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <!-- Size bound to the UI scale (RaceMenuTextButtonViewModel); the screen restyles the button every frame. -->
        <Button Name="btnBack" BorderBrush="rgb(96,96,96)" BorderThickness="2" CornerRadius="16"
                Padding="{dataBinding:MGBinding Path=BackButton.Padding}" MinWidth="{dataBinding:MGBinding Path=BackButton.MinWidth}"
                MinHeight="{dataBinding:MGBinding Path=BackButton.MinHeight}" Height="{dataBinding:MGBinding Path=BackButton.Height}"
                HorizontalAlignment="Center" HorizontalContentAlignment="Center">
          <TextBlock Text="Back" Foreground="White" FontSize="15" UseResponsiveTextScale="True" HorizontalAlignment="Center" TextAlignment="Center" />
        </Button>
      </StackPanel>
    </Border>
  </OverlayPanel>
</Window>
