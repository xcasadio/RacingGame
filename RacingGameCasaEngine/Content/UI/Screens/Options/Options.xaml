<Window xmlns="clr-namespace:MGUI.Core.UI.XAML;assembly=MGUI.Core"
        xmlns:dataBinding="clr-namespace:MGUI.Core.UI.DataBinding;assembly=MGUI.Core"
        Width="1280" Height="720" ScreenHorizontalAlignment="Stretch" ScreenVerticalAlignment="Stretch"
        WindowStyle="None" IsTitleBarVisible="False" IsUserResizable="False"
        Padding="0" BorderThickness="0" Background="rgba(0,0,0,0)">
  <!--
    Options (ADR-0014): the previous arrangement of the options, a column of labels and a column of controls, drawn with
    RacingGame's visual vocabulary. RaceOptionsViewModel lays everything out in screen pixels with RacingGame's formulas,
    every frame. The sprites are drawn first, then the texts, as TextureFont.WriteAll ran last. A round button is tinted
    with TextureColor as RacingGame tinted it: (255,156,0,160) when on, (180,180,180,120) when off. The texts use
    RacingGame's GameFont at its native size; OptionsScreen scales them at draw time as TextureFont did, and colours the
    chosen resolution and driving mode. Nothing takes MGUI's focus: OptionsScreen reads the keyboard, the typed text, the
    mouse and the gamepad itself.
  -->
  <OverlayPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <!-- Menu decoration (RaceMenuDecorationViewModel): background, then the bouncing logo placed by the view model. -->
    <Image SourceName="Ui.Menu.Background" Stretch="Fill" Opacity="0.85" IsHitTestVisible="False"
           HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
    <Image SourceName="Ui.Menu.Logo" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=Decoration.LogoMargin}"
           Width="{dataBinding:MGBinding Path=Decoration.LogoWidth}" Height="{dataBinding:MGBinding Path=Decoration.LogoHeight}" />
    <!-- Band: black at 0.683 opacity (the atlas texel's 205/255 drawn at 0.85), full width. -->
    <Border BorderThickness="0" Background="rgba(0,0,0,174)" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Top"
            Margin="{dataBinding:MGBinding Path=BandMargin}" Height="{dataBinding:MGBinding Path=BandHeightPixels}" />
    <!-- "OPTIONS" header (headers.png HeaderOptionsGfxRect), then the original's name field. -->
    <Image SourceName="Ui.Options.Header" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=Header.Margin}" Width="{dataBinding:MGBinding Path=Header.Width}" Height="{dataBinding:MGBinding Path=Header.Height}" />
    <Image SourceName="Ui.Options.NameField" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=NameField.Margin}" Width="{dataBinding:MGBinding Path=NameField.Width}" Height="{dataBinding:MGBinding Path=NameField.Height}" />
    <!-- Options: the round button (SelectionRadioButtonGfxRect), grey while off, orange while on. -->
    <Image SourceName="Ui.Button.Radio" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=FullscreenButton.Margin}" Width="{dataBinding:MGBinding Path=FullscreenButton.Width}" Height="{dataBinding:MGBinding Path=FullscreenButton.Height}" TextureColor="rgba(180,180,180,120)" Visibility="{dataBinding:MGBinding Path=FullscreenButton.Visibility}" />
    <Image SourceName="Ui.Button.Radio" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=FullscreenButton.Margin}" Width="{dataBinding:MGBinding Path=FullscreenButton.Width}" Height="{dataBinding:MGBinding Path=FullscreenButton.Height}" TextureColor="rgba(255,156,0,160)" Visibility="{dataBinding:MGBinding Path=FullscreenButton.HighlightVisibility}" />
    <Image SourceName="Ui.Button.Radio" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=VSyncButton.Margin}" Width="{dataBinding:MGBinding Path=VSyncButton.Width}" Height="{dataBinding:MGBinding Path=VSyncButton.Height}" TextureColor="rgba(180,180,180,120)" Visibility="{dataBinding:MGBinding Path=VSyncButton.Visibility}" />
    <Image SourceName="Ui.Button.Radio" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=VSyncButton.Margin}" Width="{dataBinding:MGBinding Path=VSyncButton.Width}" Height="{dataBinding:MGBinding Path=VSyncButton.Height}" TextureColor="rgba(255,156,0,160)" Visibility="{dataBinding:MGBinding Path=VSyncButton.HighlightVisibility}" />
    <Image SourceName="Ui.Button.Radio" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=PostEffectsButton.Margin}" Width="{dataBinding:MGBinding Path=PostEffectsButton.Width}" Height="{dataBinding:MGBinding Path=PostEffectsButton.Height}" TextureColor="rgba(180,180,180,120)" Visibility="{dataBinding:MGBinding Path=PostEffectsButton.Visibility}" />
    <Image SourceName="Ui.Button.Radio" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=PostEffectsButton.Margin}" Width="{dataBinding:MGBinding Path=PostEffectsButton.Width}" Height="{dataBinding:MGBinding Path=PostEffectsButton.Height}" TextureColor="rgba(255,156,0,160)" Visibility="{dataBinding:MGBinding Path=PostEffectsButton.HighlightVisibility}" />
    <Image SourceName="Ui.Button.Radio" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=ShadowsButton.Margin}" Width="{dataBinding:MGBinding Path=ShadowsButton.Width}" Height="{dataBinding:MGBinding Path=ShadowsButton.Height}" TextureColor="rgba(180,180,180,120)" Visibility="{dataBinding:MGBinding Path=ShadowsButton.Visibility}" />
    <Image SourceName="Ui.Button.Radio" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=ShadowsButton.Margin}" Width="{dataBinding:MGBinding Path=ShadowsButton.Width}" Height="{dataBinding:MGBinding Path=ShadowsButton.Height}" TextureColor="rgba(255,156,0,160)" Visibility="{dataBinding:MGBinding Path=ShadowsButton.HighlightVisibility}" />
    <Image SourceName="Ui.Button.Radio" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=ShowFpsButton.Margin}" Width="{dataBinding:MGBinding Path=ShowFpsButton.Width}" Height="{dataBinding:MGBinding Path=ShowFpsButton.Height}" TextureColor="rgba(180,180,180,120)" Visibility="{dataBinding:MGBinding Path=ShowFpsButton.Visibility}" />
    <Image SourceName="Ui.Button.Radio" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=ShowFpsButton.Margin}" Width="{dataBinding:MGBinding Path=ShowFpsButton.Width}" Height="{dataBinding:MGBinding Path=ShowFpsButton.Height}" TextureColor="rgba(255,156,0,160)" Visibility="{dataBinding:MGBinding Path=ShowFpsButton.HighlightVisibility}" />
    <Image SourceName="Ui.Button.Radio" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=VibrationButton.Margin}" Width="{dataBinding:MGBinding Path=VibrationButton.Width}" Height="{dataBinding:MGBinding Path=VibrationButton.Height}" TextureColor="rgba(180,180,180,120)" Visibility="{dataBinding:MGBinding Path=VibrationButton.Visibility}" />
    <Image SourceName="Ui.Button.Radio" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=VibrationButton.Margin}" Width="{dataBinding:MGBinding Path=VibrationButton.Width}" Height="{dataBinding:MGBinding Path=VibrationButton.Height}" TextureColor="rgba(255,156,0,160)" Visibility="{dataBinding:MGBinding Path=VibrationButton.HighlightVisibility}" />
    <!-- Sliders: the original's track, then the round handle. -->
    <Image SourceName="Ui.CarSelection.StatBar" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=SoundTrack.Margin}" Width="{dataBinding:MGBinding Path=SoundTrack.Width}" Height="{dataBinding:MGBinding Path=SoundTrack.Height}" />
    <Image SourceName="Ui.Button.Radio" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=SoundHandle.Margin}" Width="{dataBinding:MGBinding Path=SoundHandle.Width}" Height="{dataBinding:MGBinding Path=SoundHandle.Height}" />
    <Image SourceName="Ui.CarSelection.StatBar" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=MusicTrack.Margin}" Width="{dataBinding:MGBinding Path=MusicTrack.Width}" Height="{dataBinding:MGBinding Path=MusicTrack.Height}" />
    <Image SourceName="Ui.Button.Radio" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=MusicHandle.Margin}" Width="{dataBinding:MGBinding Path=MusicHandle.Width}" Height="{dataBinding:MGBinding Path=MusicHandle.Height}" />
    <Image SourceName="Ui.CarSelection.StatBar" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=SensitivityTrack.Margin}" Width="{dataBinding:MGBinding Path=SensitivityTrack.Width}" Height="{dataBinding:MGBinding Path=SensitivityTrack.Height}" />
    <Image SourceName="Ui.Button.Radio" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=SensitivityHandle.Margin}" Width="{dataBinding:MGBinding Path=SensitivityHandle.Width}" Height="{dataBinding:MGBinding Path=SensitivityHandle.Height}" />
    <!-- The selection arrow (SelectionArrowGfxRect), then B BACK, grown and outlined in orange while the mouse is over it. -->
    <Image SourceName="Ui.CarSelection.Arrow" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=Arrow.Margin}" Width="{dataBinding:MGBinding Path=Arrow.Width}" Height="{dataBinding:MGBinding Path=Arrow.Height}" />
    <Image SourceName="Ui.Button.Back" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=BackButton.Margin}" Width="{dataBinding:MGBinding Path=BackButton.Width}" Height="{dataBinding:MGBinding Path=BackButton.Height}" />
    <Image SourceName="Ui.Button.Highlight" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="{dataBinding:MGBinding Path=BackButton.Margin}" Width="{dataBinding:MGBinding Path=BackButton.Width}" Height="{dataBinding:MGBinding Path=BackButton.Height}" Visibility="{dataBinding:MGBinding Path=BackButton.HighlightVisibility}" />
    <!-- Texts, in GameFont at its native size, scaled at draw time by OptionsScreen. -->
    <TextBlock Name="txtLabel0" Text="Player Name" FontFamily="GameFont" Foreground="White" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Label0.Margin}" />
    <TextBlock Name="txtLabel1" Text="Resolution" FontFamily="GameFont" Foreground="White" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Label1.Margin}" />
    <TextBlock Name="txtLabel2" Text="Driving Mode" FontFamily="GameFont" Foreground="White" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Label2.Margin}" />
    <TextBlock Name="txtLabel3" Text="Fullscreen" FontFamily="GameFont" Foreground="White" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Label3.Margin}" />
    <TextBlock Name="txtLabel4" Text="Vertical Sync" FontFamily="GameFont" Foreground="White" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Label4.Margin}" />
    <TextBlock Name="txtLabel5" Text="Post Screen Effects" FontFamily="GameFont" Foreground="White" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Label5.Margin}" />
    <TextBlock Name="txtLabel6" Text="Shadows" FontFamily="GameFont" Foreground="White" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Label6.Margin}" />
    <TextBlock Name="txtLabel7" Text="Show FPS" FontFamily="GameFont" Foreground="White" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Label7.Margin}" />
    <TextBlock Name="txtLabel8" Text="Gamepad Vibration" FontFamily="GameFont" Foreground="White" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Label8.Margin}" />
    <TextBlock Name="txtLabel9" Text="Sound Volume" FontFamily="GameFont" Foreground="White" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Label9.Margin}" />
    <TextBlock Name="txtLabel10" Text="Music Volume" FontFamily="GameFont" Foreground="White" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Label10.Margin}" />
    <TextBlock Name="txtLabel11" Text="Controller Sensitivity" FontFamily="GameFont" Foreground="White" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=Label11.Margin}" />
    <TextBlock Name="txtName" Text="{dataBinding:MGBinding Path=NameDisplay}" FontFamily="GameFont" Foreground="White" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=NameText.Margin}" />
    <TextBlock Name="txtResolution0" Text="{dataBinding:MGBinding Path=ResolutionLabel0}" FontFamily="GameFont" Foreground="White" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=ResolutionText0.Margin}" />
    <TextBlock Name="txtResolution1" Text="{dataBinding:MGBinding Path=ResolutionLabel1}" FontFamily="GameFont" Foreground="White" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=ResolutionText1.Margin}" />
    <TextBlock Name="txtResolution2" Text="{dataBinding:MGBinding Path=ResolutionLabel2}" FontFamily="GameFont" Foreground="White" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=ResolutionText2.Margin}" />
    <TextBlock Name="txtResolution3" Text="{dataBinding:MGBinding Path=ResolutionLabel3}" FontFamily="GameFont" Foreground="White" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=ResolutionText3.Margin}" />
    <TextBlock Name="txtResolution4" Text="{dataBinding:MGBinding Path=ResolutionLabel4}" FontFamily="GameFont" Foreground="White" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=ResolutionText4.Margin}" />
    <TextBlock Name="txtArcade" Text="Arcade" FontFamily="GameFont" Foreground="White" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=ArcadeText.Margin}" />
    <TextBlock Name="txtSimulation" Text="Simulation" FontFamily="GameFont" Foreground="White" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=SimulationText.Margin}" />
    <TextBlock Name="txtSoundValue" Text="{dataBinding:MGBinding Path=SoundValue}" FontFamily="GameFont" Foreground="White" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=SoundValueText.Margin}" />
    <TextBlock Name="txtMusicValue" Text="{dataBinding:MGBinding Path=MusicValue}" FontFamily="GameFont" Foreground="White" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=MusicValueText.Margin}" />
    <TextBlock Name="txtSensitivityValue" Text="{dataBinding:MGBinding Path=SensitivityValue}" FontFamily="GameFont" Foreground="White" Padding="0" WrapText="False" ClipToBounds="False" IsHitTestVisible="False"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{dataBinding:MGBinding Path=SensitivityValueText.Margin}" />
  </OverlayPanel>
</Window>
